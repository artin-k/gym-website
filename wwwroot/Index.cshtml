@model List<string>

<h2>Website Images</h2>

<div class="image-gallery">
    @foreach (var imgPath in Model)
    {
        <img src="@imgPath" alt="Site Image" class="site-image" />
    }
</div>

<style>
    .image-gallery {
        display: flex;
        flex-wrap: wrap;
        gap: 20px;
    }

    .site-image {
        width: 300px;
        border-radius: 10px;
        box-shadow: 0 4px 10px rgba(0,0,0,0.1);
    }
</style>
